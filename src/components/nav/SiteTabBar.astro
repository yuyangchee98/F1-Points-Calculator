---
/**
 * The mobile section bar — the spine's bottom-anchored twin.
 *
 * Replaces the old Race Grid / Standings toggle (components/navigation/
 * MobileNavigation.tsx, deleted). Those were two panes of one section sitting in
 * the site's most valuable navigation slot; the panes now live in the
 * calculator's section bar, and these slots carry actual sections.
 *
 * Height is --bottombar-h, which .app and the standings pane both subtract
 * (src/index.css, Layout.tsx). It is 0px at sm+ where this is hidden, so the
 * same arithmetic works at every width. As with the spine: no circuit, driver,
 * or season names here — this renders on paywalled archive pages too.
 */
import { SECTIONS, type SectionId } from '../../utils/nav';

interface Props {
  section: SectionId;
}

const { section } = Astro.props;

/** Icon paths, keyed to section id. Order comes from SECTIONS. */
const ICONS: Record<string, string> = {
  calculator: 'M4 6h16M4 12h16m-7 6h7',
  tracks:
    'M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
  drivers: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  my9: 'M4 4h4v4H4zM10 4h4v4h-4zM16 4h4v4h-4zM4 10h4v4H4zM10 10h4v4h-4zM16 10h4v4h-4zM4 16h4v4H4zM10 16h4v4h-4zM16 16h4v4h-4z',
  compete: 'M8 21h8m-4-4v4M7 4h10v5a5 5 0 01-10 0V4zM7 7H5a2 2 0 000 4h2m10-4h2a2 2 0 010 4h-2',
  blog:
    'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m-6 4h6a2 2 0 012 2v5a2 2 0 01-2 2h-6a2 2 0 01-2-2v-5a2 2 0 012-2zm0 0V9a2 2 0 00-2-2H5',
};
---

{/* A distinct accessible name from the spine's nav: two landmarks sharing one
    name is ambiguous to screen-reader users, who get a flat list of both. */}
<nav
  aria-label="Sections (bottom bar)"
  class="fixed bottom-0 left-0 right-0 h-[var(--bottombar-h)] z-nav sm:hidden bg-carbon-900 flex"
>
  {SECTIONS.map((s) => (
    <a
      href={s.href}
      aria-current={s.id === section ? 'page' : undefined}
      class:list={[
        'relative flex-1 flex flex-col items-center justify-center gap-1 transition-colors',
        s.id === section ? 'text-white' : 'text-carbon-400',
      ]}
    >
      {s.id === section && (
        <span class="absolute top-0 inset-x-4 h-0.5 bg-brand rounded-b-sm" aria-hidden="true" />
      )}
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={ICONS[s.id]} />
      </svg>
      <span class="text-2xs font-medium leading-none">{s.label}</span>
    </a>
  ))}
</nav>
