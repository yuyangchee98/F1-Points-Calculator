---
/**
 * The spine — tier 1 of the site's chrome.
 *
 * Identical on every page, and the only place top-level navigation lives. What
 * belongs here: the sections, and nothing else. Section-specific controls
 * (season, points system, tabs, circuit pickers) belong in the section bar
 * immediately below — see components/nav/sectionBar.ts.
 *
 * ── Two rules this component must keep ──
 *
 * 1. HEIGHT. The element is sized h-[var(--spine-h)], and .app subtracts exactly
 *    that (src/index.css). Never add vertical padding, a margin, or a taller
 *    child that grows it — the calculator's body cannot scroll, so any extra
 *    pixel silently cuts the bottom row off the race grid.
 *
 * 2. NO DATA. Nothing here may enumerate circuits, drivers, or seasons. Global
 *    chrome renders on every page including the paywalled archive seasons, so a
 *    circuit list here would leak withheld race names into the DOM of all 44 of
 *    them at once — which tests/e2e/calculator.spec.ts asserts against on /2011.
 *    The circuit picker lives in the Tracks section bar, never here.
 */
import { SECTIONS, type SectionId } from '../../utils/nav';
import SpineAccountIsland from './SpineAccountIsland';
import SpineCompeteDot, { COMPETE_LINK_ID } from './SpineCompeteDot';
import FeedbackDialog from './FeedbackDialog.astro';

/**
 * The house ad: Globe Prix only — it is the one that earns. The sister
 * calculators are navigation and live in the series chip, not here.
 * ?ref= and a referrer-keeping rel (no noreferrer) so Globe Prix can count
 * these visits as the calculator's instead of as direct traffic.
 */
const AD = {
  id: 'globeprix',
  href: 'https://globeprix.chyuang.com/?ref=f1calc',
  emoji: '🌍',
  label: 'Globe Prix',
  title: 'Try my new game: Globe Prix, race every country on Earth!',
};
/**
 * The sister calculators, opened from the series chip by the logo. ?ref= and a
 * referrer-keeping rel so the sister sites can count these visits.
 */
const SERIES = [
  { id: 'f1', chip: 'F1', name: 'Formula 1', href: '/', current: true },
  { id: 'f2', chip: 'F2', name: 'Formula 2', href: 'https://f2pointscalculator.chyuang.com/?ref=f1calc', current: false },
  { id: 'motogp', chip: 'MotoGP', name: 'MotoGP', href: 'https://motogppointscalculator.chyuang.com/?ref=f1calc', current: false },
  { id: 'indycar', chip: 'IndyCar', name: 'IndyCar', href: 'https://indycarpointscalculator.chyuang.com/?ref=f1calc', current: false },
  { id: 'wec', chip: 'WEC', name: 'World Endurance', href: 'https://wecpointscalculator.chyuang.com/?ref=f1calc', current: false },
  { id: 'nascar', chip: 'NASCAR', name: 'NASCAR Cup', href: 'https://nascarpointscalculator.chyuang.com/?ref=f1calc', current: false },
];

interface Props {
  section: SectionId;
  /**
   * Whether to mount the React account island.
   *
   * It costs ~220 KB of JS (React + Redux + the auth client), which is the whole
   * payload of pages like /about and /changelog that otherwise ship none. Those
   * pass false and get the static link below instead. The link is deliberately
   * labelled "Account" rather than "Sign In": without the island there is no
   * session to read, and a "Sign In" button shown to an already-signed-in user
   * is worse than a neutral one.
   */
  account?: boolean;
}

const { section, account = true } = Astro.props;
---

<header
  class="sticky top-0 z-spine h-[var(--spine-h)] shrink-0 bg-surface border-b
         flex items-center gap-1 px-2 sm:px-4"
>
  {/* The series chip opens the sister calculators (SERIES above); its first row
      is this site's home. A <details> like the ☰ menu, so it needs no JS and the
      outside-click script at the bottom closes it too. Mirrored in the API's
      shell/spine.ts. */}
  <div class="flex items-center gap-2 mr-2 sm:mr-5 shrink-0">
    <details class="spine-more relative">
      <summary
        class="list-none inline-flex items-center gap-0.5 bg-brand text-white text-2xs sm:text-xs font-bold pl-1.5 pr-1 py-1 rounded-sm leading-none cursor-pointer hover:opacity-90"
        aria-label="F1 Points Calculator. Switch series"
        title="Switch series"
      >
        F1
        <svg class="w-3 h-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 9l6 6 6-6" />
        </svg>
      </summary>
      <nav aria-label="Series" class="absolute left-0 mt-2 w-52 bg-surface rounded-lg shadow-lg border py-1 z-overlay">
        {SERIES.map((x) => (
          <a
            href={x.href}
            {...(x.current ? { 'aria-current': 'page' } : { target: '_blank', rel: 'noopener', 'data-ad': x.id, 'data-ad-placement': 'series' })}
            class={`flex items-center gap-2.5 px-3 py-2 text-sm hover:bg-carbon-100 ${x.current ? 'text-ink font-semibold' : 'text-ink-secondary'}`}
          >
            <span class="inline-flex justify-center w-14 shrink-0 bg-brand text-white text-2xs font-bold px-1.5 py-1 rounded-sm leading-none">{x.chip}</span>
            <span class="flex-1">{x.name}</span>
            <span class="text-xs text-ink-muted" aria-hidden="true">{x.current ? '✓' : '↗'}</span>
          </a>
        ))}
      </nav>
    </details>
    <a href="/" class="hidden sm:inline font-display font-bold text-sm text-ink tracking-tight" aria-label="F1 Points Calculator, home">Points Calculator</a>
  </div>

  {/* Below sm the bottom tab bar (SiteTabBar.astro) carries every section, so
      the row is hidden there rather than repeated. From sm to lg six sections
      outgrow the row (more so with the Globe Prix pill on the right), so it
      scrolls sideways instead of running under the buttons. */}
  <nav aria-label="Sections" class="hidden sm:flex items-center h-full min-w-0 max-lg:overflow-x-auto max-lg:overflow-y-hidden scrollbar-hide">
    {SECTIONS.map((s) => (
      <a
        href={s.href}
        id={s.id === 'compete' ? COMPETE_LINK_ID : undefined}
        data-compete-dot={s.id === 'compete' ? 'spine' : undefined}
        aria-current={s.id === section ? 'page' : undefined}
        class:list={[
          'relative flex items-center shrink-0 whitespace-nowrap h-full px-2 sm:px-3.5 text-xs sm:text-sm font-semibold transition-colors',
          // Below lg the row scrolls, which clips anything past its edge, so
          // the underline sits inside it there.
          'after:absolute after:inset-x-1.5 after:-bottom-px max-lg:after:bottom-0 after:h-[2.5px] after:rounded-t-sm',
          s.id === section
            ? 'text-ink after:bg-brand'
            : 'text-ink-secondary hover:text-ink after:bg-transparent',
        ]}
      >
        {s.label}
        {s.fresh && <span class="ml-1.5 w-1.5 h-1.5 rounded-full bg-brand" aria-label="new" />}
      </a>
    ))}
  </nav>

  <div class="ml-auto flex items-center gap-1.5 sm:gap-2 shrink-0">
    {/* The promo slot: the Globe Prix pill, at every width, compact below lg. */}
    <a
      href={AD.href}
      target="_blank"
      rel="noopener"
      data-ad={AD.id}
      data-ad-slot
      aria-label={AD.title}
      title={AD.title}
      class="group inline-flex items-center gap-1 lg:gap-1.5 h-7 sm:h-8 px-2 lg:px-3 rounded-md text-xs sm:text-sm font-medium whitespace-nowrap
             bg-brand-subtle text-brand-strong border border-brand/25 hover:bg-brand-subtle/70 transition-colors"
    >
      <span class="text-sm leading-none" aria-hidden="true">{AD.emoji}</span>
      <span>{AD.label}</span>
      <svg
        class="hidden lg:block h-3 w-3 group-hover:translate-x-0.5 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
    <script is:inline>
      // One listener for the pill and the series menu's links, so clicks can be
      // compared in GA by ad_id and placement.
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('[data-ad]');
        if (!a || typeof gtag !== 'function') return;
        gtag('event', 'house_ad_click', {
          ad_id: a.getAttribute('data-ad'),
          placement: a.getAttribute('data-ad-placement') || 'spine',
        });
      });
    </script>

    {/* Feedback: opens the dialog over the page (FeedbackDialog.astro); a plain
        link to /feedback without JS. Icon-only on phones. */}
    <a
      href="/feedback"
      data-feedback
      title="Send feedback"
      aria-label="Send feedback"
      class="inline-flex items-center gap-1.5 h-7 sm:h-8 px-1.5 sm:px-2.5 rounded-md border text-xs sm:text-sm font-medium
             text-ink-secondary hover:bg-carbon-100 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h8M8 14h5M21 12a8.5 8.5 0 01-12.6 7.4L3 21l1.6-5.4A8.5 8.5 0 1121 12z" />
      </svg>
      <span class="hidden md:inline">Feedback</span>
    </a>

    {/* A native <details> so the overflow menu works with zero JS — /about and
        /changelog ship no React at all and must still be navigable. */}
    <details class="spine-more relative">
      <summary
        class="list-none inline-flex items-center justify-center h-7 sm:h-8 w-7 sm:w-8 rounded-md
               border text-ink-secondary hover:bg-carbon-100 cursor-pointer transition-colors"
        aria-label="More"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>

      <nav
        aria-label="More"
        class="absolute right-0 mt-2 w-52 bg-surface rounded-lg shadow-lg border py-1 z-overlay"
      >
        <a href="/about" class="block px-4 py-2 text-sm text-ink-secondary hover:bg-carbon-100">About</a>
        <a href="/changelog" class="block px-4 py-2 text-sm text-ink-secondary hover:bg-carbon-100">Changelog</a>
        <a
          href="https://buymeacoffee.com/yaang"
          target="_blank"
          rel="noopener noreferrer"
          class="block px-4 py-2 text-sm font-medium text-brand hover:bg-brand-subtle"
        >Support</a>
      </nav>
    </details>

    {/* Renders nothing here — it portals a deadline marker into the Compete
        link above (and the bottom tab bar's, which stands in for it on phones). Mounted in this group rather than inside that link because an
        island's hydration bootstrap would otherwise become part of the link's
        accessible name; see SpineCompeteDot.tsx. Gated on `account` with the
        island below so /about and /changelog stay React-free. */}
    {account && <SpineCompeteDot client:only="react" />}

    {/* Reserve the slot so the island mounting doesn't shift the row. */}
    <div class="flex items-center justify-end min-w-[2rem] h-7 sm:h-8">
      {account && <SpineAccountIsland client:only="react" />}
      {!account && (
        <a
          href="/compete"
          class="inline-flex items-center gap-1.5 h-7 sm:h-8 px-2 sm:px-3 text-xs sm:text-sm font-medium
                 text-ink-secondary bg-surface border rounded-md hover:bg-carbon-100 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span class="hidden sm:inline">Account</span>
        </a>
      )}
    </div>
  </div>
</header>

<FeedbackDialog />

<style>
  /* Safari still paints the default disclosure triangle without this. */
  .spine-more > summary::-webkit-details-marker { display: none; }
</style>

<script is:inline>
  // <details> closes on its own summary, but not on outside-click or Escape.
  (function () {
    document.addEventListener('click', function (e) {
      document.querySelectorAll('details.spine-more[open]').forEach(function (d) {
        if (!d.contains(e.target)) d.removeAttribute('open');
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      document.querySelectorAll('details.spine-more[open]').forEach(function (d) {
        d.removeAttribute('open');
      });
    });
  })();
</script>
