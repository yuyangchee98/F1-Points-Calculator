---
import '../index.css';
import SiteSpine from '../components/nav/SiteSpine.astro';
import SiteTabBar from '../components/nav/SiteTabBar.astro';
import { sectionForPath, type SectionId } from '../utils/nav';

interface Props {
  title: string;
  description: string;
  keywords: string;
  canonicalPath: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  schemaData?: object;
  initialYear?: number;
  /**
   * Which spine item to highlight. Defaults to whatever the URL says, so the 44
   * season pages — and every future one — need no prop at all. Pass it only to
   * override (see src/utils/nav.ts).
   */
  section?: SectionId;
  /**
   * Set false on pages that ship no React today (/about, /changelog, /404) to
   * keep them that way; the spine then renders a plain sign-in link instead of
   * the account island.
   */
  spineAccount?: boolean;
  /** Keep the page out of search results while still letting crawlers follow
   *  its links (thin driver pages: built so links never 404, but not indexed). */
  noindex?: boolean;
}

const {
  title,
  description,
  keywords,
  canonicalPath,
  ogTitle,
  ogDescription,
  ogType = 'website',
  schemaData,
  initialYear,
  section = sectionForPath(Astro.url.pathname),
  spineAccount = true,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://f1pointscalculator.chyuang.com';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogTitleFinal = ogTitle || title;
const ogDescFinal = ogDescription || description;
const ogImage = `${siteUrl}/og-image.jpg`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitleFinal} />
    <meta property="og:description" content={ogDescFinal} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitleFinal} />
    <meta name="twitter:description" content={ogDescFinal} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#E10600" />

    <!-- Preconnect to critical origins -->
    <link rel="preconnect" href="https://api.f1pointscalculator.chyuang.com" />
    <link rel="preload" href="/fonts/archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin />

    {schemaData && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    )}

    <!-- Google Analytics queue: defined first thing, so an event fired before
         gtag.js arrives (it loads after the page, below) waits in dataLayer
         instead of being dropped — e.g. My 9's share-link view on arrival. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', 'G-GJ61RX1FZJ', { cookie_domain: 'f1pointscalculator.chyuang.com' });
    </script>

    {initialYear && (
      <script define:vars={{ initialYear }}>
        window.INITIAL_YEAR = initialYear;
      </script>
    )}
  </head>
  <body class="bg-surface-sunken">
    {/* Rendered outside <slot/>, so it is a sibling of each page's #seo-content
        div rather than a child — the inline script that hides that div at parse
        time must never take the navigation with it. */}
    <SiteSpine section={section} account={spineAccount} />

    <slot />

    <SiteTabBar section={section} />

    <!-- Static footer for crawlers — visually hidden via sr-only, still in the DOM for SEO / a11y -->
    <footer id="static-footer" class="sr-only" aria-label="Site navigation">
      <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row justify-between space-y-6 sm:space-y-0">
        <div>
          <h3 class="text-lg font-medium mb-3">F1 Points Calculator</h3>
          <p class="text-sm text-gray-400 mb-2">Created by <a href="https://chyuang.com" class="text-gray-300 hover:text-white" target="_blank" rel="noopener noreferrer">Chyuang</a></p>
          <p class="text-sm text-gray-400 mb-2"><a href="https://github.com/yuyangchee98/F1-Points-Calculator" class="text-gray-300 hover:text-white" target="_blank" rel="noopener noreferrer">Open source on GitHub</a></p>
          <p class="text-sm text-gray-400 mb-2"><a href="mailto:f1pointscalculator@chyuang.com" class="text-gray-300 hover:text-white">Email me for any issues</a></p>
          <p class="text-sm text-gray-400 mb-2"><a href="/blog" class="text-gray-300 hover:text-white">Blog</a></p>
          <p class="text-sm text-gray-400 mb-2"><a href="/about" class="text-gray-300 hover:text-white">About</a></p>
          <p class="text-sm text-gray-400 mb-2"><a href="/changelog" class="text-gray-300 hover:text-white">Changelog</a></p>
        </div>
        <div>
          <h3 class="text-lg font-medium mb-3">Seasons</h3>
          <ul class="text-sm text-gray-400 space-y-1">
            <li><a href="/" class="text-gray-300 hover:text-white">2026 Season</a></li>
            <!-- season-links:start (generated by scripts/sync-season-links.mjs) -->
            <li class="flex gap-2"><span class="w-12 shrink-0 text-gray-500">2020s</span><span class="flex flex-wrap gap-x-2"><a href="/2025" class="text-gray-300 hover:text-white">2025</a> <a href="/2024" class="text-gray-300 hover:text-white">2024</a> <a href="/2023" class="text-gray-300 hover:text-white">2023</a> <a href="/2022" class="text-gray-300 hover:text-white">2022</a> <a href="/2021" class="text-gray-300 hover:text-white">2021</a> <a href="/2020" class="text-gray-300 hover:text-white">2020</a></span></li>
            <li class="flex gap-2"><span class="w-12 shrink-0 text-gray-500">2010s</span><span class="flex flex-wrap gap-x-2"><a href="/2019" class="text-gray-300 hover:text-white">2019</a> <a href="/2018" class="text-gray-300 hover:text-white">2018</a> <a href="/2017" class="text-gray-300 hover:text-white">2017</a> <a href="/2016" class="text-gray-300 hover:text-white">2016</a> <a href="/2015" class="text-gray-300 hover:text-white">2015</a> <a href="/2014" class="text-gray-300 hover:text-white">2014</a> <a href="/2013" class="text-gray-300 hover:text-white">2013</a> <a href="/2012" class="text-gray-300 hover:text-white">2012</a> <a href="/2011" class="text-gray-300 hover:text-white">2011</a> <a href="/2010" class="text-gray-300 hover:text-white">2010</a></span></li>
            <li class="flex gap-2"><span class="w-12 shrink-0 text-gray-500">2000s</span><span class="flex flex-wrap gap-x-2"><a href="/2009" class="text-gray-300 hover:text-white">2009</a> <a href="/2008" class="text-gray-300 hover:text-white">2008</a> <a href="/2007" class="text-gray-300 hover:text-white">2007</a> <a href="/2006" class="text-gray-300 hover:text-white">2006</a> <a href="/2005" class="text-gray-300 hover:text-white">2005</a> <a href="/2004" class="text-gray-300 hover:text-white">2004</a> <a href="/2003" class="text-gray-300 hover:text-white">2003</a> <a href="/2002" class="text-gray-300 hover:text-white">2002</a> <a href="/2001" class="text-gray-300 hover:text-white">2001</a> <a href="/2000" class="text-gray-300 hover:text-white">2000</a></span></li>
            <li class="flex gap-2"><span class="w-12 shrink-0 text-gray-500">1990s</span><span class="flex flex-wrap gap-x-2"><a href="/1999" class="text-gray-300 hover:text-white">1999</a> <a href="/1998" class="text-gray-300 hover:text-white">1998</a> <a href="/1997" class="text-gray-300 hover:text-white">1997</a> <a href="/1996" class="text-gray-300 hover:text-white">1996</a> <a href="/1995" class="text-gray-300 hover:text-white">1995</a> <a href="/1994" class="text-gray-300 hover:text-white">1994</a> <a href="/1993" class="text-gray-300 hover:text-white">1993</a> <a href="/1992" class="text-gray-300 hover:text-white">1992</a> <a href="/1991" class="text-gray-300 hover:text-white">1991</a> <a href="/1990" class="text-gray-300 hover:text-white">1990</a></span></li>
            <li class="flex gap-2"><span class="w-12 shrink-0 text-gray-500">1980s</span><span class="flex flex-wrap gap-x-2"><a href="/1989" class="text-gray-300 hover:text-white">1989</a> <a href="/1988" class="text-gray-300 hover:text-white">1988</a> <a href="/1987" class="text-gray-300 hover:text-white">1987</a> <a href="/1986" class="text-gray-300 hover:text-white">1986</a> <a href="/1985" class="text-gray-300 hover:text-white">1985</a> <a href="/1984" class="text-gray-300 hover:text-white">1984</a> <a href="/1983" class="text-gray-300 hover:text-white">1983</a> <a href="/1982" class="text-gray-300 hover:text-white">1982</a> <a href="/1981" class="text-gray-300 hover:text-white">1981</a> <a href="/1980" class="text-gray-300 hover:text-white">1980</a></span></li>
            <li class="flex gap-2"><span class="w-12 shrink-0 text-gray-500">1970s</span><span class="flex flex-wrap gap-x-2"><a href="/1979" class="text-gray-300 hover:text-white">1979</a> <a href="/1978" class="text-gray-300 hover:text-white">1978</a> <a href="/1977" class="text-gray-300 hover:text-white">1977</a> <a href="/1976" class="text-gray-300 hover:text-white">1976</a> <a href="/1975" class="text-gray-300 hover:text-white">1975</a> <a href="/1974" class="text-gray-300 hover:text-white">1974</a> <a href="/1973" class="text-gray-300 hover:text-white">1973</a> <a href="/1972" class="text-gray-300 hover:text-white">1972</a> <a href="/1971" class="text-gray-300 hover:text-white">1971</a> <a href="/1970" class="text-gray-300 hover:text-white">1970</a></span></li>
            <li class="flex gap-2"><span class="w-12 shrink-0 text-gray-500">1960s</span><span class="flex flex-wrap gap-x-2"><a href="/1969" class="text-gray-300 hover:text-white">1969</a> <a href="/1968" class="text-gray-300 hover:text-white">1968</a> <a href="/1967" class="text-gray-300 hover:text-white">1967</a> <a href="/1966" class="text-gray-300 hover:text-white">1966</a> <a href="/1965" class="text-gray-300 hover:text-white">1965</a> <a href="/1964" class="text-gray-300 hover:text-white">1964</a> <a href="/1963" class="text-gray-300 hover:text-white">1963</a> <a href="/1962" class="text-gray-300 hover:text-white">1962</a> <a href="/1961" class="text-gray-300 hover:text-white">1961</a> <a href="/1960" class="text-gray-300 hover:text-white">1960</a></span></li>
            <li class="flex gap-2"><span class="w-12 shrink-0 text-gray-500">1950s</span><span class="flex flex-wrap gap-x-2"><a href="/1959" class="text-gray-300 hover:text-white">1959</a> <a href="/1958" class="text-gray-300 hover:text-white">1958</a></span></li>
            <!-- season-links:end -->
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-medium mb-3">F1 Resources</h3>
          <ul class="text-sm text-gray-400 space-y-1">
            <li><a href="https://f1-dash.com/" class="text-gray-300 hover:text-white" target="_blank" rel="noopener noreferrer">F1 Dash</a></li>
            <li><a href="https://f1calendar.com/" class="text-gray-300 hover:text-white" target="_blank" rel="noopener noreferrer">F1 Calendar</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-medium mb-3">Other Projects</h3>
          <ul class="text-sm text-gray-400 space-y-1">
            <li><a href="https://drawlineracing.chyuang.com/" class="text-gray-300 hover:text-white" target="_blank" rel="noopener noreferrer">Draw Line Racing</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <!-- Google Analytics library - deferred to not block rendering; it then
         sends everything queued in dataLayer (see <head>). -->
    <script is:inline>
      window.addEventListener('load', function() {
        setTimeout(function() {
          var script = document.createElement('script');
          script.src = 'https://www.googletagmanager.com/gtag/js?id=G-GJ61RX1FZJ';
          script.async = true;
          document.head.appendChild(script);
        }, 100);
      });
    </script>
  </body>
</html>
