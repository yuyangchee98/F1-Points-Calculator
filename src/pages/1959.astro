---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppIsland from '../components/AppIsland';
import SeasonNotesSection from '../components/seo/SeasonNotesSection.astro';
const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "F1 Points Calculator 1959 - Championship Predictor",
  "description": "F1 championship calculator and standings predictor. Simulate Formula 1 race results and calculate driver points for the 1959 season.",
  "applicationCategory": "Sports Calculator",
  "operatingSystem": "Web Browser",
  "author": {
    "@type": "Person",
    "name": "Chyuang",
    "url": "https://chyuang.com"
  }
};
---

<BaseLayout
  title="F1 Points Calculator 1959 - Championship Predictor"
  description="F1 points calculator for 1959. Replay Jack Brabham's first title and the rear-engined Cooper's breakthrough, decided at the Sebring finale, with our championship simulator."
  keywords="F1, Formula 1, 1959 season, Brabham, Brooks, Moss, Cooper-Climax, Ferrari, BRM, rear-engined, Sebring, fastest lap point, points calculator, championship predictor, race simulator, F1 standings"
  canonicalPath="/1959"
  ogTitle="F1 Points Calculator 1959 - Championship Predictor"
  ogDescription="Replay Brabham's first title and the Cooper revolution with our interactive F1 calculator"
  schemaData={schemaData}
  initialYear={1959}
>
  <!-- SEO content — always in HTML, hidden once React mounts -->
  <div id="seo-content" style="padding: 20px; max-width: 900px; margin: 0 auto; font-family: system-ui, sans-serif; line-height: 1.6;">
    <h1 style="color: #dc2626;">F1 Points Calculator - 1959 Season</h1>

    <p>Explore the 1959 Formula 1 World Championship results and simulate alternative
    standings. Use our drag-and-drop calculator to replay Jack Brabham's first title, which he finished by pushing his Cooper over the line at Sebring. Scoring is 8-6-4-3-2 with a point for fastest lap, best five results.</p>

    <h2>1959 F1 Season Highlights</h2>
    <ul>
      <li>9 rounds, opening at <strong>Monaco</strong> and closing with the first <strong>United States GP at Sebring</strong>. The <strong>Indianapolis 500</strong> also counted for drivers</li>
      <li><strong>Jack Brabham wins his first World Championship</strong> (31 pts) in the rear-engined Cooper-Climax. He ran out of fuel at Sebring and pushed the car home to finish 4th</li>
      <li><strong>Tony Brooks P2</strong> (27 pts) for Ferrari, with wins at Reims and AVUS</li>
      <li><strong>Stirling Moss P3</strong> (25.5 pts). The half point came from sharing the fastest lap at Aintree with Bruce McLaren</li>
      <li><strong>Cooper-Climax win the Constructors' Cup</strong> (40 pts to Ferrari's 32), the first title for a rear-engined car</li>
      <li><strong>Bruce McLaren</strong> won at Sebring aged 22, then the youngest Grand Prix winner. <strong>Jo Bonnier</strong> gave BRM its first win at Zandvoort</li>
      <li><strong>8-6-4-3-2 plus a point for fastest lap</strong>, best five results count. Constructors counted only each team's best car, without the fastest-lap point or the Indy 500</li>
      <li>No Sprint races</li>
    </ul>

