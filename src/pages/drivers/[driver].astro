---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBar from '../../components/nav/SectionBar.astro';
import DriverCareerIsland from '../../components/driverPages/DriverCareerIsland';
import { ChartLegend, SeasonChart, ThisSeason } from '../../components/driverPages/CareerParts';
import { fetchCircuitList } from '../../utils/circuits';
import {
  allTimeRanks,
  fetchDriverCareer,
  fetchDriverIndex,
  flagEmoji,
  fmtPoints,
  isActive,
  ordinal,
  pct,
  seasonHref,
  teamSwatch,
  titleLine,
  verdict,
  yearList,
} from '../../utils/drivers';
import type { CareerSeason, DriverListItem, Milestone } from '../../types/driver';

// ---------------------------------------------------------------------------
// One page per driver since 1958. fetchDriverIndex owns the fail-the-build
// contract. Every driver gets a page, and every page is indexed.
// ---------------------------------------------------------------------------
export async function getStaticPaths() {
  const [drivers, circuits] = await Promise.all([fetchDriverIndex(), fetchCircuitList()]);
  const trackSlugs = Object.fromEntries(circuits.map((c) => [c.circuitId, c.slug]));
  return drivers.map((d) => ({ params: { driver: d.slug }, props: { entry: d, drivers, trackSlugs } }));
}

const { entry, drivers, trackSlugs } = Astro.props as {
  entry: DriverListItem;
  drivers: DriverListItem[];
  trackSlugs: Record<string, string>;
};

// Build-time fetch (unauthenticated): every season's totals, and race-by-race
// sheets only for non-archive seasons. The island refetches for subscribers.
const career = await fetchDriverCareer(entry.driverId);
const t = career.totals;
const active = isActive(career);
const slugById = new Map(drivers.map((d) => [d.driverId, d.slug]));
const driverHref = (id: string) => (slugById.has(id) ? `/drivers/${slugById.get(id)}` : null);

const { lead, rest } = verdict(career);
const description = `${lead ? `${lead} ` : ''}${rest}`.trim();
// The current season gets its own line on the page, so the on-page verdict
// leaves it out; the meta description keeps it.
const showLive = !!(career.current && active);
const pageRest = showLive ? verdict(career, { withCurrent: false }).rest : rest;
const flag = flagEmoji(career.nationality);
const yearsActive = career.firstSeason === career.lastSeason ? `${career.firstSeason}` : `${career.firstSeason}–${active ? 'present' : career.lastSeason}`;
const teamNames = [...new Set(career.seasons.flatMap((s) => s.teams.map((tm) => tm.name)))];
const ranks = allTimeRanks(career.driverId, drivers);
const PAID_SEASON_THRESHOLD = 2012;

// Milestones, in career order. Firsts that fell on the same race merge into
// one entry ("also first points and podium"). The final start only means
// something once a career is over.
const ms = career.milestones;
const race = (m: Milestone) => `${m.season} ${m.name} GP`;
type MilestoneEntry = { label: string; title: string; sub: string; also: string[]; raceId?: string; pos?: number };
const milestones: MilestoneEntry[] = [];
const firsts: Array<[string, string, Milestone | undefined, (m: Milestone) => string]> = [
  ['Debut', 'start', ms.debut, (m) => m.team],
  ['First points', 'points', ms.firstPoints, (m) => ordinal(m.pos)],
  ['First podium', 'podium', ms.firstPodium, (m) => ordinal(m.pos)],
  ['First win', 'win', ms.firstWin, (m) => `${ordinal(m.start)} career start`],
];
for (const [label, short, m, sub] of firsts) {
  if (!m) continue;
  const prev = milestones[milestones.length - 1];
  if (prev && prev.raceId === m.raceId) {
    prev.also.push(short);
    prev.pos = m.pos;
  } else {
    milestones.push({ label, title: race(m), sub: sub(m), also: [], raceId: m.raceId });
  }
}
for (const e of milestones) {
  if (!e.also.length) continue;
  const list = e.also.length === 1 ? e.also[0] : `${e.also.slice(0, -1).join(', ')} and ${e.also[e.also.length - 1]}`;
  e.sub += `${e.label === 'Debut' && e.pos ? ` · ${ordinal(e.pos)}` : ''} · also first ${list}`;
}
if (ms.winStreak) {
  const { count, from, to } = ms.winStreak;
  milestones.push({ label: 'Best run', title: `${count} wins in a row`, sub: from.season === to.season ? `${from.season}` : `${from.season}–${to.season}`, also: [] });
}
if (ms.mostWinsInSeason && ms.mostWinsInSeason.wins > 1) {
  milestones.push({ label: 'Best season', title: `${ms.mostWinsInSeason.wins} wins`, sub: `${ms.mostWinsInSeason.season}`, also: [] });
}
if (ms.lastWin && ms.firstWin && ms.lastWin.start !== ms.firstWin.start) {
  milestones.push({ label: active ? 'Latest win' : 'Last win', title: race(ms.lastWin), sub: ms.lastWin.team, also: [] });
}
if (!active && ms.finalStart) {
  milestones.push({ label: 'Final start', title: race(ms.finalStart), sub: ms.finalStart.team, also: [] });
}

// Career stats: one row, all-time rank folded into each caption.
const rankOf = (label: string) => {
  const r = ranks.find((x) => x.label === label);
  return r ? `${r.tied ? '=' : ''}${ordinal(r.rank)}` : null;
};
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
const stats: Array<{ k: string; v: string; rank: string | null; note: string | null; gold?: boolean }> = [
  {
    k: 'Titles',
    v: `${t.titles}`,
    gold: t.titles > 0,
    rank: rankOf('titles'),
    note: t.titles ? (rankOf('titles') ? null : yearList(t.titleYears)) : t.bestChampionship ? `Best: ${ordinal(t.bestChampionship)}` : 'Never classified',
  },
  { k: 'Wins', v: `${t.wins}`, rank: rankOf('wins'), note: `${pct(t.wins, t.starts)} of starts` },
  { k: 'Podiums', v: `${t.podiums}`, rank: rankOf('podiums'), note: `${pct(t.podiums, t.starts)} of starts` },
  {
    k: 'Career points',
    v: fmtPoints(t.scored),
    rank: rankOf('points'),
    note: t.scored !== t.points ? `${fmtPoints(t.points)} counted` : rankOf('points') ? null : 'as scored at the time',
  },
  { k: 'Starts', v: `${t.starts}`, rank: rankOf('starts'), note: `${plural(t.seasons, 'season')}, ${plural(t.teams, 'team')}` },
];
const extras = [
  t.sprintStarts > 0 && `${plural(t.sprintWins, 'sprint win')} from ${t.sprintStarts} starts`,
  t.fastestLaps > 0 && `${plural(t.fastestLaps, 'fastest lap')} (recorded 1958–59 and 2004 on)`,
  ranks.length > 0 && 'Ranks are all-time since 1958',
].filter(Boolean) as string[];

// Teammates: points in races together lead (always right); the finished-ahead
// count comes second and says what it is — without retirement data a DNF
// classified 16th still counts as a finish.
const mates = career.teammates;
const TOP_MATES = 4;

// Best circuits: wins, then podiums, then average finish.
const circuits = career.circuits.slice(0, 5);
const byWins = circuits.some((c) => c.wins > 0);

// Today's points system: the career total, and any title it would flip.
const flips = career.seasons.filter(
  (s) => s.position != null && s.todayPosition != null && (s.position === 1) !== (s.todayPosition === 1)
);
const showcase =
  [...career.seasons].reverse().find((s) => s.position === 1 && s.todayPoints !== s.scored) ??
  [...career.seasons].sort((a, b) => b.todayPoints - b.scored - (a.todayPoints - a.scored))[0];
const showToday = t.todayPoints !== t.scored || flips.length > 0;
const showcaseLine = showcase
  ? `${showcase.season}: ${fmtPoints(showcase.scored)} → ${fmtPoints(showcase.todayPoints)}` +
    (showcase.position && showcase.todayPosition && showcase.position !== showcase.todayPosition
      ? ` (${ordinal(showcase.position)} → ${ordinal(showcase.todayPosition)})`
      : '') +
    '.'
  : '';

const nameOf = (id: string) => mates.find((m) => m.driverId === id)?.name ?? id;
const mateNames = Object.fromEntries(mates.map((m) => [m.driverId, m.name]));
const seasonTeammates = (s: CareerSeason) => s.teammates.slice(0, 2);

const title = `${career.name}: F1 career stats, wins & teammates | F1 Points Calculator`;
const canonicalPath = `/drivers/${entry.slug}`;
const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: career.name,
      givenName: career.givenName,
      familyName: career.familyName,
      ...(career.nationality ? { nationality: career.nationality } : {}),
      description,
      url: `https://f1pointscalculator.chyuang.com${canonicalPath}`,
      jobTitle: 'Formula 1 driver',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Drivers', item: 'https://f1pointscalculator.chyuang.com/drivers' },
        { '@type': 'ListItem', position: 2, name: career.name, item: `https://f1pointscalculator.chyuang.com${canonicalPath}` },
      ],
    },
  ],
};
const head = 'flex flex-wrap items-baseline justify-between gap-x-3.5 gap-y-1 mb-3.5';
const h2 = 'font-display font-extrabold text-[19px]';
const hint = 'text-[13px] text-ink-muted';
const metaLine = [
  career.code,
  `${flag ? `${flag} ` : ''}${career.nationality}`.trim(),
  yearsActive,
  active && career.latestTeam?.name,
].filter(Boolean) as string[];
const delta = t.todayPoints - t.scored;
---

<BaseLayout
  title={title}
  description={description}
  keywords={`${career.name}, ${career.name} stats, ${career.name} wins, ${career.name} career, ${career.familyName} F1, ${career.name} teammates, ${teamNames.join(', ')}`}
  canonicalPath={canonicalPath}
  schemaData={schemaData}
>
  <SectionBar title={career.name}>
    <a href="/drivers" class="text-xs text-ink-secondary hover:text-ink">All drivers</a>
    {/* Every race this driver started, offered as their tile on My 9. */}
    <a href={`/my9?q=${encodeURIComponent(career.name)}`} class="ml-auto text-xs font-semibold text-interactive hover:underline whitespace-nowrap">My 9 as {career.familyName} →</a>
  </SectionBar>

  <div class="bg-surface text-ink min-h-[100dvh] w-full min-w-0">
    <div class="max-w-[1080px] min-w-0 mx-auto px-4 sm:px-8 pt-7 pb-10 sm:pt-9 flex flex-col gap-9 [&>*]:min-w-0">
      <header class="flex flex-col gap-5">
        <div class="min-w-0">
          <h1 class="font-display font-black text-[30px] sm:text-[44px] leading-none tracking-[-0.02em]">{career.name}</h1>
          <p class="mt-1.5 text-sm text-ink-secondary flex flex-wrap gap-x-3.5 gap-y-0.5">
            {metaLine.map((m) => <span class="whitespace-nowrap">{m}</span>)}
          </p>
        </div>

        <p class="max-w-[62ch] text-[17px] leading-normal">
          {lead && <b>{lead}</b>} {pageRest}
        </p>

        <div>
          <dl class="dp-stats" aria-label="Career totals">
            {stats.map((st) => (
              <div class="dp-stat">
                <dt class="text-[12.5px] text-ink-muted">{st.k}</dt>
                <dd class={`font-display font-extrabold text-[26px] sm:text-[32px] leading-[1.05] tracking-[-0.01em] tnum ${st.gold ? 'text-gold' : ''}`}>{st.v}</dd>
                <dd class="text-[12.5px] text-ink-secondary">
                  {st.rank && <><b class="font-semibold text-ink">{st.rank}</b> all-time</>}
                  {st.rank && st.note && ' · '}
                  {st.note}
                </dd>
              </div>
            ))}
          </dl>
          {extras.length > 0 && <p class="mt-2 text-[12.5px] text-ink-muted">{extras.join(' · ')}.</p>}
        </div>
      </header>

      {/* Static live line + chart for crawlers / no-JS: each season links to its
          calculator page. The island replaces this with the interactive chart
          and the race-by-race drill-down. */}
      <div id="driver-career-static" class="flex flex-col gap-9">
        {showLive && <ThisSeason current={career.current!} line={titleLine(career)} />}
        <section aria-label="Championship finish by season">
          <div class={head}>
            <h2 class={h2}>Championship finish by season</h2>
            <span class={hint}>Each season opens in the calculator</span>
          </div>
          <div class="overflow-x-auto -mx-1 px-1">
            <SeasonChart seasons={career.seasons} hrefFor={seasonHref} />
          </div>
          <ChartLegend seasons={career.seasons} />
        </section>
      </div>

      <DriverCareerIsland
        client:only="react"
        driverId={career.driverId}
        familyName={career.familyName}
        initialSeasons={career.seasons}
        current={active ? career.current : undefined}
        mateNames={mateNames}
        staticContainerId="driver-career-static"
        lastArchiveSeason={PAID_SEASON_THRESHOLD - 1}
      />

      {(mates.length > 0 || circuits.length > 0) && (
        <div class="grid grid-cols-[minmax(0,1fr)] gap-x-12 gap-y-9 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
          {mates.length > 0 && (
            <section aria-label="Teammates">
              <div class={head}>
                <h2 class={h2}>Against {career.familyName === career.name ? 'teammates' : `${career.familyName}'s teammates`}</h2>
                <span class={hint}>Points in races together</span>
              </div>
              {[mates.slice(0, TOP_MATES), mates.slice(TOP_MATES)].map((group, gi) => {
                const rows = group.map((m) => {
                  const total = m.points + m.matePoints || 1;
                  const href = driverHref(m.driverId);
                  const span = m.seasons.length === 1 ? `${m.seasons[0]}` : `${m.seasons[0]}–${String(m.seasons[m.seasons.length - 1]).slice(2)}`;
                  return (
                    <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-1.5 py-3 border-t first:border-t-0 first:pt-0 items-center">
                      <span class="text-[14.5px] font-semibold truncate">
                        {href ? <a href={href} class="hover:underline">{m.name}</a> : m.name}
                      </span>
                      <span class="font-display font-bold text-sm tnum whitespace-nowrap">
                        <span class={m.points > m.matePoints ? 'text-success' : ''}>{fmtPoints(m.points)}</span>{' '}
                        <span class="font-semibold text-ink-muted">– {fmtPoints(m.matePoints)}</span>
                      </span>
                      <span class="dp-h2h col-span-2" aria-hidden="true">
                        <i style={`width:${(m.points / total) * 100}%`}></i>
                      </span>
                      <span class="col-span-2 text-[12.5px] text-ink-muted">
                        {span} · {m.races} races · ahead on the results sheet {m.ahead}–{m.behind}
                      </span>
                    </div>
                  );
                });
                return gi === 0 ? (
                  <div>{rows}</div>
                ) : group.length > 0 ? (
                  <details class="dp-more">
                    <summary class="cursor-pointer pt-3 border-t text-[13.5px] font-semibold text-interactive">Show all {mates.length} teammates</summary>
                    <div>{rows}</div>
                  </details>
                ) : null;
              })}
            </section>
          )}

          {circuits.length > 0 && (
            <section aria-label="Best circuits">
              <div class={head}>
                <h2 class={h2}>Best circuits</h2>
                <span class={hint}>{byWins ? 'By wins' : 'By podiums, then average finish'}</span>
              </div>
              {circuits.map((c) => {
                const slug = trackSlugs[c.circuitId];
                const Row = slug ? 'a' : 'div';
                return (
                  <Row
                    href={slug ? `/tracks/${slug}` : undefined}
                    class="group grid grid-cols-[2.4rem_minmax(0,1fr)_auto] gap-3 items-center py-2.5 border-t first:border-t-0 first:pt-0"
                  >
                    <span class="font-display font-black text-2xl leading-none text-center tnum">{byWins ? c.wins : c.podiums}</span>
                    <span class="min-w-0">
                      <span class="block text-[14.5px] font-semibold truncate group-hover:text-interactive">{c.name}</span>
                      <span class="block text-[12.5px] text-ink-muted">
                        {c.wins > 0 ? '' : `Best ${ordinal(c.best)} · `}{c.starts} start{c.starts === 1 ? '' : 's'} · avg finish {c.avgFinish}
                      </span>
                      {c.wins > 0 && <span class="block text-[12.5px] text-ink-muted">Won {yearList(c.winYears)}</span>}
                    </span>
                    {slug && <span class="text-ink-muted group-hover:text-interactive" aria-hidden="true">→</span>}
                  </Row>
                );
              })}
            </section>
          )}
        </div>
      )}

      {milestones.length > 0 && (
        <section aria-label="Milestones">
          <div class={head}><h2 class={h2}>Milestones</h2></div>
          <dl class="dp-tl">
            {milestones.map((m) => (
              <div>
                <dt class="text-[12.5px] text-ink-muted">{m.label}</dt>
                <dd class="text-sm font-semibold">
                  {m.title}
                  <span class="block font-normal text-[13px] text-ink-secondary">{m.sub}</span>
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {showToday && showcase && (
        <section aria-label="Under today's points system">
          <div class={head}>
            <h2 class={h2}>Under today's points system</h2>
            <span class={hint}>25-18-15-12-10-8-6-4-2-1, scored by the calculator</span>
          </div>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5 rounded-[10px] bg-surface-sunken px-4 py-4">
            <div class="font-display font-extrabold text-[26px] leading-none tnum flex items-baseline gap-2.5 whitespace-nowrap">
              <span>{fmtPoints(t.scored)}</span>
              <span class="text-ink-muted font-medium" aria-hidden="true">→</span>
              <span class="text-interactive">{fmtPoints(t.todayPoints)}</span>
              {delta !== 0 && (
                <small class={`font-sans text-[13px] font-semibold ${delta > 0 ? 'text-success' : 'text-ink-muted'}`}>
                  {delta > 0 ? '+' : '−'}{fmtPoints(Math.abs(delta))}
                </small>
              )}
            </div>
            <p class="flex-[1_1_300px] text-sm text-ink-secondary">
              Career points re-scored with today's table. {showcaseLine}{' '}
              <a href={seasonHref(showcase.season)} class="text-interactive hover:underline whitespace-nowrap">Replay {showcase.season} in the calculator →</a>
            </p>
          </div>
          {flips.length > 0 && (
            <ul class="mt-3 text-sm flex flex-col gap-1">
              {flips.map((s) => (
                <li>
                  <b>{s.season}:</b>{' '}
                  {s.todayPosition === 1
                    ? `would have been champion (was ${ordinal(s.position!)})`
                    : `would have finished ${ordinal(s.todayPosition!)} instead of winning the title`}
                </li>
              ))}
            </ul>
          )}
        </section>
      )}

      <section aria-label="All seasons">
        <div class={head}>
          <h2 class={h2}>All seasons</h2>
          <span class={hint}>Points as counted for the championship</span>
        </div>
        <div class="overflow-x-auto">
          <table class="dp-table w-full min-w-[600px] border-collapse text-sm">
            <thead>
              <tr>
                <th>Year</th>
                <th>Team</th>
                <th class="r">Pos</th>
                <th class="r">Pts</th>
                <th class="r">Wins</th>
                <th class="r">Podiums</th>
                <th>Teammate</th>
              </tr>
            </thead>
            <tbody>
              {[...career.seasons].reverse().map((s) => (
                <tr>
                  <td><a href={seasonHref(s.season)} class="font-bold hover:underline">{s.season}</a></td>
                  <td>
                    {s.teams[0] && <span class="dp-sw" style={teamSwatch(s.teams[0])}></span>}
                    {s.teams.map((tm) => tm.name).join(' / ')}
                  </td>
                  <td class="r"><span class={`dp-pill ${s.position === 1 ? 'ch' : ''}`}>{s.excluded ? 'DSQ' : s.position ?? '–'}</span></td>
                  <td class="r tnum">
                    {fmtPoints(s.points)}{s.scored !== s.points && <span class="text-ink-muted"> ({fmtPoints(s.scored)} scored)</span>}
                  </td>
                  <td class={`r tnum ${s.wins ? '' : 'zero'}`}>{s.wins}</td>
                  <td class={`r tnum ${s.podiums ? '' : 'zero'}`}>{s.podiums}</td>
                  <td class="text-ink-secondary">
                    {seasonTeammates(s).map((id, i) => {
                      const href = driverHref(id);
                      return (
                        <>
                          {i > 0 && ', '}
                          {href ? <a href={href} class="hover:underline">{nameOf(id)}</a> : nameOf(id)}
                        </>
                      );
                    })}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {career.seasons.some((s) => s.excluded) && (
          <p class="mt-2 text-[12.5px] text-ink-muted">DSQ: excluded from that year's drivers' championship; the race results stand.</p>
        )}
      </section>

      <p class="text-[12.5px] text-ink-muted">
        Starts count Grands Prix with a classified result, sprints excluded. Figures cover the World Championship from 1958.
      </p>
    </div>
  </div>
</BaseLayout>
