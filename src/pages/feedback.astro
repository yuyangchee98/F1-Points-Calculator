---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Feedback - F1 Points Calculator"
  description="Send feedback, bug reports or ideas for the F1 Points Calculator."
  keywords="F1 points calculator feedback, bug report"
  canonicalPath="/feedback"
  spineAccount={false}
  noindex
>
  <div class="min-h-screen bg-surface-sunken py-6">
    <div class="max-w-xl mx-auto px-4">
      <h1 class="text-2xl font-display font-bold text-ink mb-6">Feedback</h1>

      <form id="feedback-form" class="p-5 bg-surface rounded-lg shadow-xs border space-y-3" novalidate>
        <textarea
          name="message"
          required
          maxlength="5000"
          rows="6"
          placeholder="Bug, idea, missing feature…"
          class="w-full px-3 py-2 border rounded-md bg-surface text-ink text-base resize-y focus:outline-none focus:ring-2 focus:ring-brand"
        ></textarea>
        <input
          type="email"
          name="email"
          autocomplete="email"
          placeholder="Email (optional, for a reply)"
          class="w-full px-3 py-2 border rounded-md bg-surface text-ink text-base focus:outline-none focus:ring-2 focus:ring-brand"
        />
        {/* Honeypot: hidden from people, filled in by bots. */}
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
        <div class="flex items-center gap-3">
          <button
            type="submit"
            class="inline-flex items-center justify-center h-10 px-5 rounded-md bg-brand text-white font-semibold text-sm hover:opacity-90 transition-opacity disabled:opacity-50"
          >Send</button>
          <p id="feedback-error" class="text-sm text-red-600" role="alert"></p>
        </div>
      </form>

      <div id="feedback-done" class="hidden p-8 bg-surface rounded-lg shadow-xs border text-center">
        <svg class="w-10 h-10 mx-auto text-green-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <p class="mt-3 text-lg font-display font-semibold text-ink">Thanks!</p>
      </div>
    </div>
  </div>

  <script>
    const API = import.meta.env.PUBLIC_API_BASE_URL;
    const form = document.getElementById('feedback-form') as HTMLFormElement;
    const error = document.getElementById('feedback-error')!;
    const button = form.querySelector('button')!;

    // The page they came from, so a bug report says where it happened.
    let from: string | null = null;
    try {
      const ref = new URL(document.referrer);
      if (ref.origin === location.origin && ref.pathname !== '/feedback') from = ref.pathname + ref.search;
    } catch { /* no referrer */ }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const message = String(data.get('message') || '').trim();
      if (!message) {
        error.textContent = 'Write something first.';
        return;
      }
      error.textContent = '';
      button.disabled = true;
      try {
        const res = await fetch(`${API}/api/feedback`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, email: data.get('email'), website: data.get('website'), page: from }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(body.error || 'Something went wrong. Try again.');
        form.classList.add('hidden');
        document.getElementById('feedback-done')!.classList.remove('hidden');
      } catch (err) {
        error.textContent = err instanceof Error && err.message !== 'Failed to fetch' ? err.message : 'Couldn’t send. Try again.';
        button.disabled = false;
      }
    });
  </script>
</BaseLayout>
