---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppIsland from '../components/AppIsland';
import SeasonNotesSection from '../components/seo/SeasonNotesSection.astro';
const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "F1 Points Calculator 1980 - Championship Predictor",
  "description": "F1 championship calculator and standings predictor. Simulate Formula 1 race results and calculate driver points for the 1980 season.",
  "applicationCategory": "Sports Calculator",
  "operatingSystem": "Web Browser",
  "author": {
    "@type": "Person",
    "name": "Chyuang",
    "url": "https://chyuang.com"
  }
};
---

<BaseLayout
  title="F1 Points Calculator 1980 - Championship Predictor"
  description="F1 points calculator for 1980. Replay Alan Jones' title and Williams' first Constructors' Championship with our championship simulator."
  keywords="F1, Formula 1, 1980 season, Alan Jones, Nelson Piquet, Reutemann, Williams FW07, Brabham BT49, FISA-FOCA, ground effect, points calculator, championship predictor, race simulator, F1 standings"
  canonicalPath="/1980"
  ogTitle="F1 Points Calculator 1980 - Championship Predictor"
  ogDescription="Replay Alan Jones and Williams' 1980 with our interactive F1 calculator"
  schemaData={schemaData}
  initialYear={1980}
>
  <!-- SEO content — always in HTML, hidden once React mounts -->
  <div id="seo-content" style="padding: 20px; max-width: 900px; margin: 0 auto; font-family: system-ui, sans-serif; line-height: 1.6;">
    <h1 style="color: #dc2626;">F1 Points Calculator - 1980 Season</h1>

    <p>Explore the 1980 Formula 1 World Championship results and simulate alternative
    standings. Use our drag-and-drop calculator to replay Alan Jones' title fight with Nelson Piquet. Drivers kept their best five results from each half of the season (seven races each), while constructors counted every race and every car.</p>

    <h2>1980 F1 Season Highlights</h2>
    <ul>
      <li>14 rounds, opening in <strong>Argentina</strong> and closing at <strong>Watkins Glen</strong></li>
      <li><strong>Alan Jones wins the World Championship</strong> (67 pts) with five wins in the Williams FW07B</li>
      <li><strong>Nelson Piquet P2</strong> (54 pts) for Brabham. His engine failed at Montreal, the race that settled the title</li>
      <li><strong>Carlos Reutemann P3</strong> (42 pts) for Williams</li>
      <li><strong>Williams win their first Constructors' Championship</strong> (120 pts to Ligier's 66)</li>
      <li>The <strong>FISA–FOCA war</strong> cost the Spanish GP its championship status. Didier Pironi won his first race at Zolder</li>
      <li><strong>Patrick Depailler</strong> was killed testing at Hockenheim</li>
      <li><strong>9-6-4-3-2-1 points system</strong>. Drivers counted their best 5 of the first 7 + best 5 of the last 7. <strong>Constructors counted every race and every car</strong></li>
      <li>No Sprint races, no fastest lap bonus point</li>
    </ul>

    <SeasonNotesSection year={1980} />

